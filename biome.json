{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/playwright-report/**",
      "!**/test-results/**"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noDebugger": "error",
        "noExplicitAny": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  }
}
